{
  "name": "zendesk-equalizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web npm:server npm:web",
    "server": "node --env-file=.env --watch server/index.js",
    "web": "vite web",
    "build": "vite build web",
    "start": "node --env-file=.env server/index.js",
    "test": "node --test server/*.test.js web/src/*.test.js"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "express": "^5.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
